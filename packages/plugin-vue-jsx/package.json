{
	"name": "@codeeditorlandjs/plugin-vue-jsx",
	"version": "0.0.1",
	"private": false,
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/VitePluginVue#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/VitePluginVue/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/VitePluginVue.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "unbuild && pnpm run patch-cjs",
		"dev": "unbuild --stub",
		"patch-cjs": "tsx ../../scripts/patchCJS.ts",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"dependencies": {
		"@babel/plugin-transform-typescript": "7.27.0",
		"@vue/babel-plugin-jsx": "1.4.0"
	},
	"devDependencies": {
		"@playform/build": "0.2.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
