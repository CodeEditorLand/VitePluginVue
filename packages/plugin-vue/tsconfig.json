{
	"compilerOptions": {
		"baseUrl": "./",
		"declaration": true,
		"esModuleInterop": true,
		"module": "ES2020",
		"moduleResolution": "node",
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"outDir": "Target",
		"resolveJsonModule": true,
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "ES2020"
	},
	"exclude": [
		"**/*.spec.ts"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src",
		"src",
		"src"
	]
}
