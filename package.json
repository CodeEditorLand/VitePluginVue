{
	"name": "@codeeditorlandjs/vite-plugin-vue-monorepo",
	"version": "0.0.1",
	"private": false,
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/VitePluginVue#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/VitePluginVue/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/VitePluginVue.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter='./packages/*' run build",
		"ci-publish": "tsx scripts/publishCI.ts",
		"debug-build": "VITE_TEST_BUILD=1 VITE_PRESERVE_BUILD_ARTIFACTS=1 vitest run -c vitest.config.e2e.ts",
		"debug-serve": "VITE_DEBUG_SERVE=1 vitest run -c vitest.config.e2e.ts",
		"dev": "pnpm -r --parallel --filter='./packages/*' run dev",
		"preinstall": "npx only-allow pnpm",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"release": "tsx scripts/release.ts",
		"test-build": "VITE_TEST_BUILD=1 vitest run -c vitest.config.e2e.ts",
		"test-build-without-plugin-commonjs": "VITE_TEST_WITHOUT_PLUGIN_COMMONJS=1 pnpm test-build",
		"test-serve": "vitest run -c vitest.config.e2e.ts"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged --concurrent false"
	},
	"lint-staged": {
		"*": [
			"prettier --write --cache --ignore-unknown"
		],
		"packages/**/*.d.ts": [
			"eslint --cache --fix"
		],
		"packages/*/{src,types}/**/*.ts": [
			"eslint --cache --fix"
		],
		"playground/**/__tests__/**/*.ts": [
			"eslint --cache --fix"
		]
	},
	"dependencies": {},
	"devDependencies": {
		"@babel/types": "7.27.0",
		"@codeeditorlandjs/release-scripts": "1.3.2",
		"@playform/build": "0.2.3",
		"@types/convert-source-map": "2.0.3",
		"@types/debug": "4.1.12",
		"@types/fs-extra": "11.0.4",
		"@types/node": "22.15.2",
		"conventional-changelog-cli": "5.0.0",
		"eslint-plugin-import-x": "4.11.0",
		"eslint-plugin-regexp": "2.7.0",
		"execa": "9.5.2",
		"fs-extra": "11.3.0",
		"lint-staged": "15.5.1",
		"npm-run-all2": "7.0.2",
		"picocolors": "1.1.1",
		"playwright-chromium": "1.52.0",
		"simple-git-hooks": "2.13.0",
		"tsx": "4.19.3",
		"unbuild": "3.5.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"pnpm": {
		"overrides": {
			"@vitejs/plugin-vue": "workspace:*"
		}
	}
}
