{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"jsx": "preserve",
		"module": "ESNext",
		"moduleResolution": "Node",
		"noUnusedLocals": true,
		"outDir": "Target",
		"paths": {
			"~utils": [
				"./test-utils.ts"
			]
		},
		"resolveJsonModule": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"target": "ES2020",
		"types": [
			"vite/client",
			"node"
		]
	},
	"exclude": [
		"**/dist/**"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		".",
		"src",
		"src"
	]
}
